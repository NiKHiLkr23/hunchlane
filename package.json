{
  "name": "hunchlane",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "next dev --webpack --port 3100",
    "build": "next build --webpack",
    "start": "next start --port 3100",
    "jobs:dev": "npx --yes --ignore-scripts=false inngest-cli@latest dev --host 127.0.0.1 --no-discovery --persist -u http://localhost:3100/api/inngest",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "integrations:check": "tsx scripts/check-integrations.ts",
    "crust:check": "tsx scripts/crust-check.ts",
    "sponsored:check": "tsx scripts/sponsored-check.ts",
    "budget:configure": "tsx scripts/configure-budget.ts",
    "cfo:probe": "tsx scripts/cfo-probe.ts",
    "vault:init": "tsx scripts/init-vault.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.14",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "inngest": "^4.23.0",
    "lucide-react": "^1.55.0",
    "neatlogs": "^1.1.28",
    "next": "^16.4.0",
    "openai": "^7.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@next/env": "^16.4.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
