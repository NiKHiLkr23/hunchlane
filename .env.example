# Copy to .env.local. Never commit secrets. All keys below are server-only unless NEXT_PUBLIC.
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/new
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/new
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
LITELLM_API_KEY=
LITELLM_MODEL=claude-sonnet-4.6
# Sponsored endpoint is fixed in code. It supports Chat Completions, not verified hosted web search.
CRUSTDATA_API_KEY=
# auto chooses Crustdata + sponsored models when configured, otherwise OpenAI hosted search.
RESEARCH_PROVIDER=auto
# Operator-approved credits from your Crustdata allocation. 0 keeps Crustdata spending disabled.
# Full report reserves 5 credits; refinement reserves 4. Run pnpm budget:configure after changes.
CRUSTDATA_CREDIT_BUDGET=0
NEATLOGS_API_KEY=
# Enable remote jobs after connecting Inngest. Local: pnpm jobs:dev
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1
# App budget in cents. The public slice defaults to $15 of the approved $25 total.
RESEARCH_BUDGET_CENTS=1500
# CFO's OAuth MCP connection must be verified first. Use /setup as the authorized operator.
CFO_OPERATOR_USER_ID=
CREDENTIALS_ENCRYPTION_KEY=
CFO_ORG_ID=
# Path to a recipe built from the authenticated server's actual instructions and tool schemas.
CFO_MODEL_RECIPE_PATH=
CFO_INTEGRATION_VERIFIED=false
